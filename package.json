{
  "name": "nzeru-za-alimi",
  "private": true,
  "workspaces": [
    "server"
  ],
  "scripts": {
    "start": "npm start -w server",
    "dev": "npm run dev -w server",
    "test": "npm test -w server",
    "ussd": "npm run ussd -w server",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@eslint/js": "^9.16.0",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,html,css}": [
      "prettier --write"
    ]
  }
}
