# PostgreSQL Configuration
POSTGRES_USER=nzeru
POSTGRES_PASSWORD=change-this-secure-password
POSTGRES_DB=nzeru

# Application Configuration
NODE_ENV=production
PORT=4000
JWT_SECRET=change-this-to-a-long-random-string-min-32-chars
LOG_LEVEL=info

# Database URL (matches postgres service)
DATABASE_URL=postgres://nzeru:change-this-secure-password@postgres:5432/nzeru
