# Pre-Shared Key Authentication
# Format: <local-ip> <remote-ip> : PSK "<secret-key>"

37.60.252.211 41.78.57.35 : PSK "GET_PSK_FROM_AIRTEL"

# Alternative format using VPN identifiers:
# @nzeru-vpn-gateway @airtel-vpn-gateway : PSK "GET_PSK_FROM_AIRTEL"

# ===========================================================================
# AFTER RECEIVING PSK FROM AIRTEL:
# 1. Replace "GET_PSK_FROM_AIRTEL" with the actual PSK
# 2. Save this file
# 3. Set correct permissions: chmod 600 /etc/ipsec.secrets
# 4. Restart IPSec: sudo ipsec restart
# 5. Start tunnel: sudo ipsec up airtel-ussd-s2s
